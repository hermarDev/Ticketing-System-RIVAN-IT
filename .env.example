# Required — Supabase (public client keys only)
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Optional — Free Location System (Nominatim / Maps)
# Same-origin Nominatim proxy base in production (recommended for User-Agent compliance).
# Dev uses Vite proxy at /api/nominatim automatically when unset.
# VITE_NOMINATIM_BASE=/api/nominatim
#
# Map picker (Leaflet + OSM tiles + Nominatim reverse) needs no API keys.
# Attribution is shown on the map; no VITE_* key is required for map selection.

# Optional — Google Places upgrade path (not required; Nominatim is the default).
# When set, searchAddress may use Places in a future release; today it still falls back to Nominatim.
# VITE_GOOGLE_MAPS_API_KEY=
